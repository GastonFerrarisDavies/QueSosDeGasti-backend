POSTGRES_USER=gasti
POSTGRES_PASSWORD=gasti
POSTGRES_DB=quesosdegasti
# Host "db" = servicio de docker compose. Para correr la API fuera de Docker usá localhost.
DATABASE_URL=postgres://gasti:gasti@db:5432/quesosdegasti?sslmode=disable
OPENAI_API_KEY=apikey
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
ALLOWED_ORIGINS=http://localhost:3000
